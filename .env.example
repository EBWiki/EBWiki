# EBWiki environment variables (sample)
# Copy this file to `.env` in the repo root before running the app locally.
# Use fake placeholders only — never commit real secrets.
# Staging/Railway variable names and Doppler mapping: docs/STAGING_RAILWAY.md

# --- Rails core ---
# RAILS_ENV — Required. Rails environment (use `development` locally; `staging` on Railway).
RAILS_ENV=development
# SECRET_KEY_BASE — Required in staging/production. Run `bin/rails secret` locally or copy from Doppler `ebwiki/stg`.
SECRET_KEY_BASE=generate_with_rails_secret_minimum_thirty_characters
# HOST — Optional locally. Public hostname for URL generation and staging host authorization (e.g. staging.ebwiki.org); see `config/initializers/staging_railway_hosts.rb`.
HOST=localhost
# RAILS_LOG_TO_STDOUT — Optional. Set in production so logs go to stdout (`config/environments/production.rb`).
RAILS_LOG_TO_STDOUT=
# RAILS_SERVE_STATIC_FILES — Optional. Set in production when Puma should serve precompiled assets from `/public` (`config/environments/production.rb`).
RAILS_SERVE_STATIC_FILES=

# --- Database ---
# DATABASE_URL — Required on Railway/staging (sole DB config). Local dev: Postgres URL or use `config/database.yml` from `config/database.example.yml`.
DATABASE_URL=postgres://localhost/blackops_development
# BLACKOPS_DATABASE_PASSWORD — Optional locally. Used by committed `database.example.yml` production section; not needed when using `DATABASE_URL` or local peer auth.
BLACKOPS_DATABASE_PASSWORD=fakepassword

# --- Redis ---
# REDIS_URL — Required for caching in staging/production. Local default: redis://localhost:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Search (Elasticsearch) ---
# ELASTICSEARCH_URL — Preferred search cluster URL. Local: run Elasticsearch or point at a dev instance.
ELASTICSEARCH_URL=http://localhost:9200
# SEARCHBOX_URL — Optional legacy fallback if ELASTICSEARCH_URL is unset (`config/initializers/searchbox.rb`).
SEARCHBOX_URL=http://localhost:9200

# --- AWS / S3 uploads (CarrierWave) ---
# On staging, if AWS keys are blank, uploads use local file storage instead of Fog/S3 (`config/initializers/carrier_wave.rb`).
# AWS_ACCESS_KEY_ID — Optional locally unless testing S3 uploads. From AWS IAM or Doppler `ebwiki/stg`.
AWS_ACCESS_KEY_ID=fake_access_key_id
# AWS_SECRET_KEY_ID — Optional; pairs with access key. Note this app uses `_KEY_ID`, not `_ACCESS_KEY`.
AWS_SECRET_KEY_ID=fake_secret_access_key
# S3_BUCKET — Optional unless using Fog storage. Bucket name for case uploads.
S3_BUCKET=fake_s3_bucket
# S3_REGION — Optional. AWS region for sitemap generation (`config/sitemap.rb`).
S3_REGION=us-east-1
# FOG_DIRECTORY — Optional. Fog/S3 directory name (sitemaps and related tooling).
FOG_DIRECTORY=fake_fog_directory

# --- Mailchimp ---
# MAILCHIMP_API_KEY — Optional locally. API key from Mailchimp or ask an EBWiki maintainer / Doppler `ebwiki/stg`.
MAILCHIMP_API_KEY=fake_mailchimp_api_key
# MAILCHIMP_LIST_ID — Optional. Audience/list ID for newsletter subscriptions.
MAILCHIMP_LIST_ID=fake_mailchimp_list_id
# MAILCHIMP_LINK — Optional. Sign-up URL shown in the site header.
MAILCHIMP_LINK=https://example.com/mailchimp-signup

# --- Google (Analytics, Tag Manager, Maps) ---
# GOOGLE_ANALYTICS_MEASUREMENT_ID — Optional. gtag.js measurement ID in `app/views/layouts/application.html.erb`.
GOOGLE_ANALYTICS_MEASUREMENT_ID=fake_ga_measurement_id
# GOOGLE_TAG_MANAGER_ID — Optional. GTM container ID for the noscript iframe in the layout.
GOOGLE_TAG_MANAGER_ID=fake_gtm_id
# GOOGLE_MAPS_API_KEY — Optional. Geocoding (`config/initializers/geocoder.rb`).
GOOGLE_MAPS_API_KEY=fake_google_maps_api_key

# --- Staging access (HTTP basic auth on RAILS_ENV=staging only) ---
# STAGING_USERNAME — Required on staging. Value from Doppler `ebwiki/stg` (not committed here).
# STAGING_PASSWORD — Required on staging. Value from Doppler `ebwiki/stg` (not committed here).

# --- Rollbar ---
# ROLLBAR_ACCESS_TOKEN — Optional locally. Project access token from Rollbar or Doppler `ebwiki/stg`.
ROLLBAR_ACCESS_TOKEN=fake_rollbar_access_token
# ROLLBAR_ENV — Optional. Environment label sent to Rollbar (e.g. development, staging).
ROLLBAR_ENV=development

# --- Deploy / revision (Railway staging) ---
# DEPLOY_REV — Optional. Git SHA exposed on `/up` and `/health` JSON and in the footer HTML comment; override for smoke checks.
DEPLOY_REV=
# RAILWAY_GIT_COMMIT_SHA — Optional; set automatically by Railway on Git deploys (same role as DEPLOY_REV).
# RAILWAY_GIT_COMMIT_SHA=

# --- Misc ---
# EBWIKI_SITEMAP_URL — Optional. URL to the published sitemap archive.
EBWIKI_SITEMAP_URL=http://bow-sitemaps.s3.amazonaws.com/sitemaps/sitemap.xml.gz
# CODECLIMATE_REPO_TOKEN — Optional. Used by Code Climate test reporter in CI, not required for local app boot.
CODECLIMATE_REPO_TOKEN=fake_codeclimate_token
