# Sample .env file
# These properties need to be filled in in order for EBWiki to run properly
# Copy this to .env before running the development server

AWS_ACCESS_KEY_ID=fake_access_key_id
AWS_SECRET_KEY_ID=fake_secret_access_key
S3_BUCKET=fake_s3_bucket
S3_REGION=us-east-1
# S3-compatible fallback (Railway, R2, etc.) used when AWS is down or unset.
# STORAGE_PROVIDER=auto
# FALLBACK_S3_ACCESS_KEY_ID=
# FALLBACK_S3_SECRET_ACCESS_KEY=
# FALLBACK_S3_BUCKET=
# FALLBACK_S3_ENDPOINT=
# FALLBACK_S3_REGION=auto
MAILCHIMP_API_KEY=Get this from Mailchimp or talk to someone at EBWiki
MAILCHIMP_LINK=Get this from Mailchimp or talk to someone at EBWiki
MAILCHIMP_LIST_ID=Get this from Mailchimp or talk to someone at EBWiki
SEARCHBOX_URL='http://localhost:9200'
CODECLIMATE_REPO_TOKEN=EBWiki devs can provide a token if needed
EBWIKI_SITEMAP_URL=http://bow-sitemaps.s3.amazonaws.com/sitemaps/sitemap.xml.gz
GA_MEASUREMENT_ID=EBWiki devs can provide if needed
BLACKOPS_DATABASE_PASSWORD=fakepassword

# Optional HTTP Basic Auth for staging and preview apps.
# Production stays public unless HTTP_BASIC_AUTH_ENABLED=true.
# HTTP_BASIC_AUTH_ENABLED=true
# HTTP_BASIC_AUTH_USERNAME=ebwiki
# HTTP_BASIC_AUTH_PASSWORD=choose-a-strong-password
# STAGING_USERNAME=ebwiki
# STAGING_PASSWORD=choose-a-strong-password