# Sample .env file
# These properties need to be filled in in order for EBWiki to run properly
# Copy this to .env before running the development server

AWS_ACCESS_KEY_ID=fake_access_key_id
AWS_SECRET_KEY_ID=fake_secret_access_key
S3_BUCKET=fake_s3_bucket
MAILCHIMP_API_KEY=Get this from Mailchimp or talk to someone at EBWiki
MAILCHIMP_LINK=Get this from Mailchimp or talk to someone at EBWiki
MAILCHIMP_LIST_ID=Get this from Mailchimp or talk to someone at EBWiki
SEARCHBOX_URL='http://localhost:9200'
CODECLIMATE_REPO_TOKEN=EBWiki devs can provide a token if needed
EBWIKI_SITEMAP_URL=http://bow-sitemaps.s3.amazonaws.com/sitemaps/sitemap.xml.gz
GA_MEASUREMENT_ID=EBWiki devs can provide if needed
BLACKOPS_DATABASE_PASSWORD=fakepassword

# Friendly photos — Wikimedia Commons + English Wikipedia + Openverse only
# CI/Playwright: E2E_STUB_WIKIMEDIA=1 and FRIENDLY_PHOTOS_STUB_AI=1
# Railway preview https://ebwiki-web-production.up.railway.app/friendly_photos
# currently has REVIEW_SERVER=1, E2E_STUB_WIKIMEDIA=0, OPENAI_API_KEY set
# (SearchPlanner + VisionClassifier; no silent heuristic fallback when a key is set).
# Local live search: E2E_STUB_WIKIMEDIA=0. Without an AI key, HeuristicPlanner
# + metadata classification. With a key, planner/vision must succeed.
# E2E_STUB_WIKIMEDIA=0
# REVIEW_SERVER=0
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FRIENDLY_PHOTOS_OPENAI_MODEL=gpt-4o-mini
# FRIENDLY_PHOTOS_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# FRIENDLY_PHOTOS_REQUIRE_AI=0
# FRIENDLY_PHOTOS_VISION_LIMIT=12
# FRIENDLY_PHOTOS_HIT_LIMIT=5
# FRIENDLY_PHOTOS_MAX_QUERIES=6
# FRIENDLY_PHOTOS_AI_TIMEOUT=12
# FRIENDLY_PHOTOS_STUB_AI=0