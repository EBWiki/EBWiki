# Copy to backend.hcl (gitignored) and run: tofu init -backend-config=backend.hcl
#
# Bootstrap once in AWS (operator): private S3 bucket, versioning on, SSE-KMS or SSE-S3,
# DynamoDB table for locks, IAM policy scoped to this bucket/key prefix.
#
# State object for this stack only (separate from infra/cloudflare in GKT-1293 / PR #4528).

bucket         = "ebwiki-opentofu-state"
key            = "staging/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "ebwiki-opentofu-locks"
