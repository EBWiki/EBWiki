<% editor_name = User.find(@this_case.versions.last.whodunnit).name %>
<h1><%= @this_case.title %> was updated</h1>
<p><%= editor_name %> updated <%= link_to @this_case.title, case_url(@this_case.id) %> on EBWiki.</p>
<p>Summary: "<%= @this_case.versions.last.comment %>"</p>
<p>You can add sources on this or <%= link_to 'other cases', root_url %>.</p>
