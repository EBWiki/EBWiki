<%= form_for :conversation, url: :conversations, html: { class: "" } do |f| %>
    <div class="mb-3">
      <%= f.label :recipients, class: "form-label" %>
      <%= f.select(:recipients, @other_users, {}, { multiple: true, class: "form-select", placeholder: "Select other EBWiki users to message" })%>
    </div>
    <div class="mb-3">
      <%= f.label :subject, class: "form-label" %>
      <%= f.text_field :subject, placeholder: "Subject", class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.label :message, class: "form-label" %>
      <%= f.text_area :body, class: 'form-control', placeholder: "Type your message here", rows: 4  %>
    </div>

    <%= f.submit "Send Message", class: "btn btn-success" %>
<% end %>
