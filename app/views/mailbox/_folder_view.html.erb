<div class="row">
  <div class="spacer"></div>
  <div class="col-md-12">
    <div class="spacer"></div>
  </div>

  <div class="col-md-4 mailFolder">
    <div class="card">
      <div class="card-body">
        <%= render 'mailbox/folders' %>
      </div>
    </div>
  </div>

  <div class="col-md-8 mailFolder">
    <div class="card">
      <div class="card-body">
        <% if is_conversation %>
          <%= render 'conversations/form' %>
        <% else %>
          <%= render partial: 'conversations/conversation', collection: conversations %>
        <% end %>
      </div>
    </div>
  </div>
</div>
