<p id="notice"><%= notice %></p>

<h1>Organizations</h1>

<% if @organizations.empty? %>
  <p>No organizations are listed yet.</p>
<% else %>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Website</th>
      <th>Telephone</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <%= render @organizations %>
  </tbody>
</table>
<% end %>

<br>

<%= link_to 'New Organization', new_organization_path %>
