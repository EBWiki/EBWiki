<header class="ebwiki-site-header" id="ebwiki-site-header">
  <div class="ebwiki-header-inner">
    <%= link_to root_path, class: "ebwiki-wordmark-link" do %>
      <%= ebwiki_wordmark(variant: :on_dark) %>
    <% end %>

    <button type="button" class="ebwiki-nav-toggle" aria-expanded="false" aria-controls="ebwiki-header-menu" data-ebwiki-nav-toggle>
      Menu
    </button>

    <div class="ebwiki-header-menu" id="ebwiki-header-menu">
      <div class="ebwiki-header-search">
        <%= render "search/bar" %>
      </div>

      <ul class="ebwiki-header-nav">
        <li><%= link_to "About", about_path %></li>
        <% if user_signed_in? %>
          <li><%= link_to "Add a New Case", new_case_path %></li>
          <li><%= link_to "Get our newsletter", ENV["MAILCHIMP_LINK"] %></li>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">
              <%= current_user.email %><span class="caret"></span>
            </a>
            <ul class="dropdown-menu" role="menu">
              <% if current_user.admin? %>
                <li><%= link_to "Admin", admin_root_path %></li>
              <% end %>
              <li><%= link_to "Profile", user_path(current_user) %></li>
              <li><%= link_to "View Inbox", mailbox_inbox_path %></li>
              <li><%= link_to "Log Out", destroy_user_session_path, method: :delete %></li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to "Login", new_user_session_path %></li>
          <li class="ebwiki-cta"><%= link_to "Sign Up", new_user_registration_path, class: "btn" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</header>
