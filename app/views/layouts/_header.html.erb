<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top">
  <div class="container-fluid">
    <%= link_to image_tag('EBWikiLogo.png', size: "90x23", alt: "EBWiki"), root_path, class: "navbar-brand" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="main-navbar">
      <%= render "search/bar" %>
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to 'About', about_path, class: "nav-link" %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Add a New Case", new_case_path, class: "nav-link", title: "Did we miss a case? Use search first to avoid duplicates." %>
          </li>
          <li class="nav-item">
            <%= link_to 'Get our newsletter', ENV['MAILCHIMP_LINK'], class: "nav-link" %>
          </li>
          <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><%= current_user.email %></a>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if current_user.admin? %>
                <li><%= link_to "Admin", admin_root_path, class: "dropdown-item" %></li>
              <% end %>
              <li><%= link_to "Profile", user_path(current_user), class: "dropdown-item" %></li>
              <li><%= link_to "View Inbox", mailbox_inbox_path, class: "dropdown-item" %></li>
              <li><%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item"><%= link_to "Login", new_user_session_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Sign Up", new_user_registration_path, class: "nav-link" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
