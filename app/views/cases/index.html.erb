<!-- Since this is the homepage,the meta tag information for this page is set as the default values. -->

<div class="ebwiki-home-layout">
  <div>
    <h1 class="ebwiki-home-finding">
      EBWiki users are tracking <strong><%= @total_cases %></strong>
      <%= "case".pluralize(@total_cases) %> of people killed by police.
    </h1>
    <p class="ebwiki-home-lead">
      <%= link_to "Login", new_user_session_path %> or <%= link_to "Sign Up", new_user_registration_path %>
      to follow a case or to add or update cases.
    </p>

    <ol class="ebwiki-case-records" id="front-gallery">
      <% @cases.each do |this_case| %>
        <%= render "case_record", this_case: this_case %>
      <% end %>
    </ol>

    <%= paginate @cases %>
    <p class="ebwiki-pagination-meta"><%= page_entries_info @cases %></p>
  </div>
  <aside id="front-sidebar">
    <h2 class="ebwiki-sidebar-heading">Recently updated</h2>
    <table class="ebwiki-records-table leader-list">
      <thead>
        <tr>
          <th scope="col">Case</th>
          <th scope="col">Updated</th>
        </tr>
      </thead>
      <tbody>
        <% @recently_updated_cases.each do |this_case| %>
          <tr>
            <td><%= link_to_case_title(this_case, 25) %></td>
            <td><time datetime="<%= this_case.updated_at.iso8601 %>"><%= display_updated_at(this_case) %></time></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </aside>
</div>
