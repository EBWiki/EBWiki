<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>

  <% if page.resource.pending? %>
    <div>
      <%= image_tag page.resource.image_url, style: 'max-width: 320px; max-height: 320px;' %>
    </div>
    <div style="margin-top: 1rem;">
      <%= button_to 'Approve and attach to case',
                    approve_admin_case_photo_candidate_path(page.resource),
                    method: :post,
                    class: 'button' %>
      <%= form_with url: reject_admin_case_photo_candidate_path(page.resource), method: :post, local: true do |f| %>
        <%= f.label :rejection_reason, 'Rejection note (optional)' %>
        <%= f.text_area :rejection_reason, rows: 2 %>
        <%= f.submit 'Reject', class: 'button button--danger' %>
      <% end %>
    </div>
  <% end %>
</header>

<section class="main-content__body">
  <dl>
    <% page.attributes.each do |title, attributes| %>
      <fieldset class="<%= "field-unit--nested" if title.present? %>">
        <% if title.present? %>
          <legend><%= t "helpers.label.#{page.resource_name}.#{title}", default: title %></legend>
        <% end %>

        <% attributes.each do |attribute| %>
          <dt class="attribute-label" id="<%= attribute.name %>">
            <%= t(
              "helpers.label.#{resource_name}.#{attribute.name}",
              default: page.resource.class.human_attribute_name(attribute.name),
            ) %>
          </dt>

          <dd class="attribute-data attribute-data--<%=attribute.html_class%>">
            <% if attribute.name == :source_page_url && page.resource.source_page_url.present? %>
              <%= link_to page.resource.source_page_url, page.resource.source_page_url, target: '_blank', rel: 'noopener' %>
            <% elsif attribute.name == :image_url %>
              <%= link_to page.resource.image_url, page.resource.image_url, target: '_blank', rel: 'noopener' %>
            <% else %>
              <%= render_field attribute, page: page %>
            <% end %>
          </dd>
        <% end %>
      </fieldset>
    <% end %>
  </dl>
</section>
