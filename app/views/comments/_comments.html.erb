

<div class="">
  <ul class="col-md-12">
    <% @comments.each do |comment| %>
      <li class="col-md-12">
        <small class="timeAgo"><%= time_ago_in_words(comment.created_at) %> ago <%= link_to comment.user.name, user_path(comment.user) %></small>
        <p><%= simple_format comment.content %></p>
        <% if current_user&.admin? && comment.commentable %>
          <%= button_to 'Delete comment', [comment.commentable, comment], method: :delete,
                        class: 'btn btn-danger btn-xs',
                        data: { confirm: 'Delete this comment?' } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>