<div class="well">
  <%= form_for [@this_case, @comment], html: { class: 'form-inline', role: 'form' } do |f| %>
    <% if @comment.errors.any? %>
      <div class="error-messages" role="alert">
        <h2>Please correct the following errors:</h2>
        <ul>
          <% @comment.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :content, 'Comment on this case' %>
      <%= f.text_area :content, rows: 4, class: 'form-control', required: true %>
    </div>
    <div class="form-group">
      <div class="actions">
        <%= f.submit 'Add comment', class: 'btn btn-default' %>
      </div>
    </div>
  <% end %>
</div>
