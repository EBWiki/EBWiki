<h1>Profile pictures</h1>
<p>
  Help people already on EBWiki have a healthy profile picture — a family
  photo, portrait, or other image that honors them. Search the existing
  cases, then look on Wikimedia and Openverse for an openly licensed
  photo. Nothing is attached until an editor reviews and approves it.
</p>

<%= form_with url: friendly_photos_path, method: :get, html: { class: 'form-inline', style: 'margin-bottom: 1em;', data: { testid: 'case-search-form' } } do %>
  <%= hidden_field_tag :filter, @filter %>
  <div class="form-group" style="margin-right: 0.5em;">
    <%= label_tag :q, 'Name', class: 'sr-only' %>
    <%= text_field_tag :q, @query, class: 'form-control', placeholder: 'Name or title', data: { testid: 'search-name' } %>
  </div>
  <div class="form-group" style="margin-right: 0.5em;">
    <%= label_tag :location, 'Location', class: 'sr-only' %>
    <%= text_field_tag :location, @location, class: 'form-control', placeholder: 'City or state', data: { testid: 'search-location' } %>
  </div>
  <div class="form-group" style="margin-right: 0.5em;">
    <%= label_tag :date, 'Date', class: 'sr-only' %>
    <%= date_field_tag :date, @date, class: 'form-control', data: { testid: 'search-date' } %>
  </div>
  <div class="form-group" style="margin-right: 0.5em;">
    <%= label_tag :case_id, 'Case ID', class: 'sr-only' %>
    <%= text_field_tag :case_id, @case_id, class: 'form-control', placeholder: 'ID or slug', data: { testid: 'search-case-id' } %>
  </div>
  <%= submit_tag 'Find case', class: 'btn btn-primary', data: { testid: 'search-cases' } %>
<% end %>

<ul class="nav nav-pills" style="margin-bottom: 1em;">
  <% friendly_photo_filters.each do |value, label| %>
    <li class="<%= 'active' if @filter == value %>">
      <%= link_to label, friendly_photos_path(filter: value, q: @query, location: @location, date: @date, case_id: @case_id), data: { testid: "filter-#{value}" } %>
    </li>
  <% end %>
</ul>

<% if @cases.any? %>
  <table class="table table-striped" data-testid="friendly-photos-table">
    <thead>
      <tr>
        <th>Current photo</th>
        <th>Person</th>
        <th>Case</th>
        <th>Location</th>
        <th>Date</th>
        <th>Photo type</th>
        <th>Candidates</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cases.each do |this_case| %>
        <tr data-testid="case-row-<%= this_case.slug %>">
          <td>
            <% if this_case.avatar? %>
              <%= image_tag this_case.avatar.small_avatar.url, alt: this_case.subject_display_name %>
            <% else %>
              <%= image_tag 'default-user-icon.png', size: '35x35', alt: 'No photo' %>
            <% end %>
          </td>
          <td><%= this_case.subject_display_name %></td>
          <td><%= link_to this_case.title, this_case %></td>
          <td><%= this_case.city %><%= ", #{this_case.state.name}" if this_case.state %></td>
          <td><%= this_case.date %></td>
          <td><%= this_case.avatar_kind_label %></td>
          <td><%= pending_friendly_photo_count(this_case) %></td>
          <td><%= link_to 'Review photos', friendly_photo_path(this_case), class: 'btn btn-warning btn-sm', data: { testid: "find-photos-#{this_case.slug}" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @cases %>
<% else %>
  <p data-testid="no-cases">No cases match this search.</p>
<% end %>
