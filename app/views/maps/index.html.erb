<div class="container">
    <div class="row">
    	<div class="col-lg-12">
	     	<% if user_signed_in? %>
		     	<p>Follow a case from its page to receive updates as it proceeds.</p>
			<% else %>
		    	<p><%= link_to 'Sign in', new_user_session_path %> to follow a case and receive updates as it proceeds.</p>
			<% end %>
			<div class="text-center">
				<h3>
					<%= link_to 'Back to the Main Page', root_path, class: "btn btn-warning" %>
					<%= link_to 'Get our newsletter', "http://eepurl.com/bt5QCz", class: "btn btn-default" %>
				</h3>
			</div>
			<h2 class="page-subheader">Select a map pin to open the case.</h2>
			<div id="markers-on-the-map">
	    		<div id="map-page-header">
		    		<div id="map-container"></div>
					<script type="text/javascript">window.CASES = '<%= j @cases %>';</script>
	    		</div>
		   	</div>
		</div>
	</div>
</div>
