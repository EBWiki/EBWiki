<div class="container">
  <section class="userAvatar">
    <div class="row">
      <div class="col-md-2">
        <%= image_tag avatar_url(@user, 200), class: "img-rounded img-responsive", alt: "" %>
        <p><%= @user.name %></p>
        <p>Last seen at <%= l(@user.last_sign_in_at, format: "%-d.%m.%Y %H:%M:%S") %></p>
        <% if @user == current_user %>
          <div class="panel panel-default mailFoldershort">
            <div class="panel-body">
              Your Mailboxes:
              <%= render 'mailbox/folders' %>
            </div>
          </div>
        <% else %>
          <%= link_to "Send a Message", new_conversation_path, class: "btn btn-success" %>
        <% end %>
      </div>
      <div class="col-md-10">
        <div class="alert alert-info">
          <div class="user-header">
            <h4><%= "#{@user.name}'s bio:" %></h4>
            <% if policy(@user).edit? %>
              <%= link_to 'Edit profile', edit_user_path(@user.id), class: "btn btn-success btn-capitalized" %>
            <% end %>
          </div>
          <% if @user.description.present? %>
            <p class="user-description"><%= @user.description %></p>
          <% else %>
            <p class="user-description">This profile has no bio yet.</p>
          <% end %>
        </div>
        <% if @user == current_user %>
          <h3 class="page-header">
            <% if @cases.size.zero? %>
              You are not following any cases yet. Open a case and choose Follow to get updates.
            <% else %>
              Cases we are tracking for you:
            <% end %>
          </h3>
        <% else %>
          <h3 class="page-header">
            <% if @cases.size.zero? %>
              <%= @user.name %> is not following any cases.
            <% else %>
              Cases <%= @user.name %> follows:
            <% end %>
          </h3>
        <% end %>
        <%= render partial: 'cases/thumbnail', layout: 'cases/show_thumbnail', collection: @cases, as: :this_case %>
      </div>
    </div>
  </section>
</div>
