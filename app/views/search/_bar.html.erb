<%= form_tag search_path, method: :get, class: "d-flex flex-wrap align-items-center gap-2 me-3" do %>
  <%= select_tag(:state_id,
        options_from_collection_for_select(@state_objects || [], :id, :name, params[:state_id]),
        prompt: "Filter By State",
        class: 'form-select') %>
  <%= text_field_tag :query, params[:query], class: 'form-control', placeholder: 'Name, City or Keywords...' %>
  <%= submit_tag "Search", class: "btn btn-primary search-btn" %>
<% end %>
