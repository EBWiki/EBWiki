<%= form_tag search_path, method: :get, class: "ebwiki-search-form" do %>
  <%= label_tag :state_id, "Filter by state", class: "visually-hidden" %>
  <%= select_tag(:state_id,
        options_from_collection_for_select(@state_objects || [], :id, :name, params[:state_id]),
        prompt: "State",
        class: "form-control ebwiki-search-form__state") %>
  <%= label_tag :query, "Search", class: "visually-hidden" %>
  <%= text_field_tag :query, params[:query], class: "form-control ebwiki-search-form__query", placeholder: "Name, city, or keywords" %>
  <%= submit_tag "Search", class: "btn btn-search" %>
<% end %>
