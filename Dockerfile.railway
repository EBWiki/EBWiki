# Railway staging image for EBWiki (main branch). The root Dockerfile stays
# unchanged for Docker Hub dev builds via publish_docker_image.yml.
FROM ruby:3.4.2-slim

ENV RAILS_ENV=staging
ENV BUNDLE_PATH=/usr/local/bundle
ENV BUNDLE_WITHOUT="development:test"
ENV RAILS_SERVE_STATIC_FILES=true
ENV RAILS_LOG_TO_STDOUT=true

RUN apt-get update -qq && apt-get install -y \
    build-essential \
    libpq-dev \
    postgresql-client \
    curl \
    git \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/ebwiki

COPY Gemfile Gemfile.lock ./
RUN bundle config --global frozen 1 && \
    bundle install

COPY . .

COPY config/database.railway.yml config/database.yml

RUN mkdir -p tmp/pids log public/assets && \
    SECRET_KEY_BASE=build-time-dummy bundle exec rails assets:precompile

EXPOSE 3000

CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
