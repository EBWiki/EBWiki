# This is checked into source control, so put secrets into `.env.local`.
#
# Point Hanami at the same Postgres the Rails app uses. Schema ownership
# stays with Rails (`db/structure.sql`); this app does not run migrations.
#
# See https://hanakai.org/learn/hanami/app/settings for how `.env` files are loaded.

DATABASE_URL=postgres://localhost/ebwiki_development
