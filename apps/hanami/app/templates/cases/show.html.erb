<article class="case-page">
  <p class="crumb"><a href="/">All cases</a></p>

  <div class="case-layout">
    <aside class="case-media">
      <% if (image_url = case_image_url(this_case)) %>
        <img src="<%= image_url %>" alt="" class="case-avatar">
      <% else %>
        <div class="case-avatar case-avatar-placeholder" aria-hidden="true">EB</div>
      <% end %>
    </aside>

    <div class="case-body">
      <header>
        <h1>
          <%= subjects.first&.name || this_case.title %><% if subjects.first&.age %>, <%= subjects.first.age %><% end %>
        </h1>
        <p class="lede">
          <%= this_case.city %><% if state %>, <%= state.name %><% end %>
          <br>
          <%= format_date(this_case.date) %>
        </p>
      </header>

      <% if agencies.any? %>
        <p><strong>Agencies:</strong> <%= agencies.map(&:name).join(" | ") %></p>
      <% end %>

      <p>
        <strong>Cause of death:</strong>
        <%= cause_of_death_label(this_case.cause_of_death) %>
      </p>

      <p class="meta">Last updated: <%= format_time(this_case.updated_at) %></p>

      <section>
        <h2>Overview</h2>
        <%== rich_text(this_case.overview) %>
      </section>

      <% if this_case.litigation.to_s.strip != "" %>
        <section>
          <h2>Legal Action</h2>
          <%== rich_text(this_case.litigation) %>
        </section>
      <% end %>

      <% if this_case.community_action.to_s.strip != "" %>
        <section>
          <h2>Community and Family Efforts</h2>
          <%== rich_text(this_case.community_action) %>
        </section>
      <% end %>

      <% if this_case.video_url.to_s.strip != "" %>
        <p><a href="<%= this_case.video_url %>">Video</a></p>
      <% end %>

      <% if links.any? %>
        <section>
          <h2>Additional Resources</h2>
          <ul class="resource-links">
            <% links.each do |link| %>
              <li>
                <a href="<%= link.url %>" rel="noopener noreferrer" target="_blank"><%= link.url %></a>
                <% if link.created_at %>
                  <span class="meta">added <%= format_time(link.created_at) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
</article>
