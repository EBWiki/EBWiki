<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EBWiki</title>
    <meta name="description" content="Documenting people of color killed by law enforcement.">
    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">EBWiki</a>
        <nav>
          <a href="/">Cases</a>
          <a href="/search">Search</a>
          <a href="/agencies">Agencies</a>
          <a href="/organizations">Organizations</a>
          <a href="/about">About</a>
          <a href="/cases/new">Add a case</a>
          <% if current_user %>
            <a href="/users/<%= current_user.id %>"><%= current_user.name %></a>
            <% if current_user.admin %>
              <a href="/admin/users">Staff</a>
            <% end %>
            <form action="/logout" method="post" class="nav-form">
              <button type="submit">Logout</button>
            </form>
          <% else %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
          <% end %>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <%= yield %>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Hanami public site sharing the Rails Postgres schema. Rails still owns mailers, S3 uploads, and production cutover.</p>
      </div>
    </footer>
    <%= javascript_tag "app" %>
  </body>
</html>
