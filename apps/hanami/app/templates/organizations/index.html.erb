<section>
  <h1>Organizations</h1>
  <% if organizations.empty? %>
    <p>No organizations have been loaded yet.</p>
  <% else %>
    <ul>
      <% organizations.each do |organization| %>
        <li><a href="/organizations/<%= organization.id %>"><%= organization.name %></a></li>
      <% end %>
    </ul>
  <% end %>
</section>
